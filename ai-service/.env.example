# ai-service/.env.example
# Copy to .env and fill in

# Database - Uses existing MySQL from Laravel
DATABASE_URL=mysql+pymysql://${DB_USERNAME}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_DATABASE}

# Vector Store - ChromaDB (runs in Docker)
CHROMA_HOST=chromadb
CHROMA_PORT=8000
CHROMA_COLLECTION=drug_embeddings

# Redis (for Celery queue)
REDIS_URL=redis://redis:6379/0

# Laravel Backend API
LARAVEL_API_URL=http://host.docker.internal:8000/api
LARAVEL_API_TOKEN=your_laravel_sanctum_token_here

# Model Settings
MODEL_DIR=./models
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
FORECAST_HORIZON_DAYS=30
MIN_HISTORY_DAYS=90

# App
DEBUG=true
HOST=0.0.0.0
PORT=8000