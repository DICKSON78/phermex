# Copy to dashboard/.env (gitignored) and fill in from the Firebase console.
# Must match the GOOGLE_FIREBASE_* values in the backend .env.
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: only when the project does not use the defaults derived from
# VITE_FIREBASE_PROJECT_ID.
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_STORAGE_BUCKET=

# Existing local setting
VITE_PWA_URL=http://localhost:3002
