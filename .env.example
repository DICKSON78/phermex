# Shared env template for the Helix platform (Laravel API + Vite frontends).
# Copy this file to .env and adjust values locally.
# Never commit real .env files — they may contain secrets.

# ---- Frontend (website & dashboard) ----
VITE_DASHBOARD_URL=http://localhost:3001
VITE_API_URL=http://localhost:8002/api

# ---- Laravel backend ----
APP_NAME=Helix
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=pharmex
# DB_USERNAME=root
# DB_PASSWORD=

CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# ---- Production scaling (50M+ users / pharmacies) ----
# Install Redis on the server, then flip these four together. The read-cache
# layer (pharmacy/drug listings, barcode lookups) works on ANY driver, so the
# app stays correct even before Redis is installed — Redis just makes it fast.
#   apt install redis-server php-redis   (or: composer require predis/predis)
# then:
# CACHE_DRIVER=redis
# SESSION_DRIVER=redis
# QUEUE_CONNECTION=redis
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=null
# REDIS_CACHE_DB=1
# REDIS_QUEUE_DB=2
# Run queue workers:  php artisan queue:work redis --sleep=2 --tries=3
# Memory: cache TTLs are short and versioned, so growth is bounded.

# ---- Laravel Octane (concurrent PHP; Phase 2) ----
# Requires the Swoole PHP extension on the server: `pecl install swoole` (or
# use roadrunner/owlet). Nginx proxies to the Octane port (deploy/*.conf).
# OCTANE_SERVER=swoole
# OCTANE_WORKERS=auto

# ---- MySQL read replica (Phase 2) ----
# Leave DB_READ_HOST empty and the app keeps using only the master. Set it
# once a replica exists (e.g. `mysqldump --single-transaction --source-data=2`)
# SELECTs then go to the replica, writes stay on the master.
# DB_READ_HOST=10.0.0.20
# DB_READ_PORT=3306
# DB_READ_DATABASE=pharmex
# DB_READ_USERNAME=replica_user
# DB_READ_PASSWORD=secret

# ---- Object storage + CDN (Phase 2) ----
# Add `composer require league/flysystem-aws-s3-v3` (already required here),
# create a bucket in your region, then:
# FILESYSTEM_DISK=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=eu-west-1
# AWS_BUCKET=pharmex-uploads
# AWS_URL=https://d1.cdn.example.com   # CDN origin for the bucket if you have one

SANCTUM_STATEFUL_DOMAINS=localhost:3000,localhost:5173
FRONTEND_URL=http://localhost:3000

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@pharmex.com"
MAIL_FROM_NAME="${APP_NAME}"

PHARMEX_CURRENCY=TZS
PHARMEX_TAX_RATE=18
PHARMEX_DEFAULT_COUNTRY=Tanzania

# ======================================================================
# PRODUCTION VALUES (www.pharmexdawa.online) — set these on the server:
# ----------------------------------------------------------------------
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://www.pharmexdawa.online
# FRONTEND_URL=https://www.pharmexdawa.online
# SANCTUM_STATEFUL_DOMAINS=www.pharmexdawa.online,pharmexdawa.online
#
# MAIL_MAILER=smtp            # required for password-reset codes to deliver!
# MAIL_HOST=...               # your SMTP provider
# MAIL_PORT=587
# MAIL_USERNAME=...
# MAIL_PASSWORD=...
# MAIL_ENCRYPTION=tls
# MAIL_FROM_ADDRESS="noreply@pharmexdawa.online"
#
# DB_CONNECTION=mysql (+ real credentials)
# QUEUE_CONNECTION=redis  # see the Redis block above; run `php artisan queue:work redis`
#
# CLICKPESA_WEBHOOK_SECRET=<random shared secret>  # required for payment webhooks (HMAC)
#
# NOTE: route caching (`php artisan route:cache`) is NOT supported —
# routes/web.php uses closures. Use `php artisan optimize:clear` instead.
# ======================================================================

# ClickPesa payment gateway
CLICKPESA_ENABLED=false
CLICKPESA_CLIENT_ID=
CLICKPESA_API_KEY=
CLICKPESA_WEBHOOK_SECRET=
CLICKPESA_BASE_URL=https://api.clickpesa.com/third-parties

# Google sign-in (Firebase)
# Copy these from Firebase console > Project settings > General > Your apps.
# Every one is required; there are no built-in defaults, so sign-in stays off
# rather than silently falling back to another project's credentials.
GOOGLE_FIREBASE_PROJECT_ID=
GOOGLE_FIREBASE_APP_ID=
GOOGLE_FIREBASE_WEB_API_KEY=
# Comma separated. Must include the Web API key, the Web app id, the Android app
# id (1:<number>:android:<hash>) and the Android OAuth client id, otherwise the
# token is rejected as "invalid Google token".
GOOGLE_ALLOWED_AUDIENCES=

# Firebase Cloud Messaging (push notifications)
FCM_SERVER_KEY=
FCM_PROJECT_ID=